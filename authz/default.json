{
  "lms_root_url": "http://local.edly.io",
  "authz_client_id": "login-service-client-id",
  "permissions_per_request": 10,
  "course_direct_scopes": [
    "course-v1:WGU+CS+2026",
    "course-v1:edunext+PY+2026",
    "course-v1:OpenedX+DMS+2026"
  ],
  "course_glob_patterns": [
    "course-v1:WGU+*",
    "course-v1:edunext+*",
    "course-v1:OpenedX+*"
  ],
  "library_direct_scopes": [
    "lib:WGU:CSPROB",
    "lib:edunext:Python",
    "lib:OpenedX:DMS"
  ],
  "library_glob_patterns": [
    "lib:WGU:*",
    "lib:edunext:*",
    "lib:OpenedX:*"
  ],
  "run_setup": true,
  "sleep_time": 1,
  "stages": [
    { "target": 10, "duration": "2m" },
    { "target": 10, "duration": "3m" },
    { "target": 0, "duration": "2m" }
  ]
}
